{
  "manifest_version": 3,
  "name": "DevSec Toolkit - JWT, Headers & JSON Tools",
  "short_name": "DevSec Toolkit",
  "version": "1.0.0",
  "description": "Free JWT decoder, security headers checker, secret scanner, JSON formatter, Base64 & hash tools. Runs 100% locally.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "DevSec Toolkit",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
